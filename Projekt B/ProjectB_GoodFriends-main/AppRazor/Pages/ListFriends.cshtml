@page
@model ListFriendsModel
@using Models.Interfaces

@{
    ViewData["Title"] = "List of All Friends";
}

<div class="container px-4 py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>List of All Friends</h1>
            <p class="text-muted">View all friends, optionally filtered by country and/or city</p>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="row mb-4">
        <div class="col-12">
            <form method="post" class="bg-light p-3 rounded">
                <div class="row mb-3">
                    <div class="col-md-5">
                        <label for="countrySelect" class="form-label">Country</label>
                        <select class="form-select" name="country" id="countrySelect">
                            <option value="">-- All Countries --</option>
                            @foreach (var country in Model.Countries)
                            {
                                <option value="@country" selected="@(Model.SelectedCountry == country)">@country</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label for="citySelect" class="form-label">City</label>
                        <select class="form-select" name="city" id="citySelect" disabled="@string.IsNullOrEmpty(Model.SelectedCountry)">
                            <option value="">-- All Cities --</option>
                            @foreach (var city in Model.Cities)
                            {
                                <option value="@city" selected="@(Model.SelectedCity == city)">@city</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Filter</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Table -->
    <div class="row">
        <div class="col-12">
            @if (Model.Friends.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>City</th>
                                <th>Country</th>
                                <th>Email</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var friend in Model.Friends)
                            {
                                <tr>
                                    <td>@friend.FirstName @friend.LastName</td>
                                    <td>@friend.Address?.City</td>
                                    <td>@friend.Address?.Country</td>
                                    <td>@friend.Email</td>
                                    <td>
                                        <a href="/FriendDetails/@friend.FriendId" class="btn btn-sm btn-info">Details & Edit</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    No friends found@(
                        !string.IsNullOrEmpty(Model.SelectedCountry) && !string.IsNullOrEmpty(Model.SelectedCity) 
                            ? $" in {Model.SelectedCity}, {Model.SelectedCountry}"
                            : !string.IsNullOrEmpty(Model.SelectedCountry)
                                ? $" in {Model.SelectedCountry}"
                                : ""
                    )
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.getElementById('countrySelect').addEventListener('change', function() {
        // Reset city dropdown when country changes
        if (this.value === '') {
            document.getElementById('citySelect').disabled = true;
            document.getElementById('citySelect').value = '';
        } else {
            document.getElementById('citySelect').disabled = false;
        }
    });
</script>
