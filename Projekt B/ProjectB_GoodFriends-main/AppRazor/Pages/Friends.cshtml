@page
@model FriendsModel
@using Models.Interfaces

@{
    ViewData["Title"] = "Friends by Country";
}

<div class="container px-4 py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Friends by Country</h1>
            <p class="text-muted">Select a country to view friends</p>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="row mb-4">
        <div class="col-md-6">
            <form method="post" class="d-flex gap-2">
                <select class="form-select" name="country" id="countrySelect">
                    <option value="">-- Select Country --</option>
                    @foreach (var country in Model.Countries)
                    {
                        <option value="@country" selected="@(Model.SelectedCountry == country)">@country</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>
        </div>
    </div>

    <!-- Results Table -->
    <div class="row">
        <div class="col-12">
            @if (Model.Friends.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>City</th>
                                <th>Email</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var friend in Model.Friends)
                            {
                                <tr>
                                    <td>@friend.FirstName @friend.LastName</td>
                                    <td>@friend.Address?.City</td>
                                    <td>@friend.Email</td>
                                    <td>
                                        <a href="/FriendDetails/@friend.FriendId" class="btn btn-sm btn-info">View Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (!string.IsNullOrEmpty(Model.SelectedCountry))
            {
                <div class="alert alert-info" role="alert">
                    No friends found in @Model.SelectedCountry
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    Select a country to view friends
                </div>
            }
        </div>
    </div>
</div>
