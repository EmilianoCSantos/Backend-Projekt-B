@page "{id:guid}"
@model FriendDetailsModel
@using Models.Interfaces

@{
    ViewData["Title"] = Model.Friend != null ? $"{Model.Friend.FirstName} {Model.Friend.LastName}" : "Friend Details";
}

<div class="container px-4 py-4">
    <!-- Back Button -->
    <div class="row mb-4">
        <div class="col-12">
            <a href="/Friends" class="btn btn-secondary">← Back to Friends</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }
    else if (Model.Friend != null)
    {
        <!-- Friend Information -->
        <div class="row mb-5">
            <div class="col-12">
                <h1>@Model.Friend.FirstName @Model.Friend.LastName</h1>
                <div class="card">
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h6 class="text-muted">Email</h6>
                                <p>@Model.Friend.Email</p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted">Birthday</h6>
                                <p>@(Model.Friend.Birthday?.ToString("yyyy-MM-dd") ?? "Not set")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Information -->
        @if (Model.Friend.Address != null)
        {
            <div class="row mb-5">
                <div class="col-12">
                    <h3>Address</h3>
                    <div class="card">
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <h6 class="text-muted">Street Address</h6>
                                    <p>@Model.Friend.Address.StreetAddress</p>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-muted">Zip Code</h6>
                                    <p>@Model.Friend.Address.ZipCode</p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="text-muted">City</h6>
                                    <p>@Model.Friend.Address.City</p>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-muted">Country</h6>
                                    <p>@Model.Friend.Address.Country</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Pets -->
        <div class="row mb-5">
            <div class="col-12">
                <h3>Pets</h3>
                @if (Model.Friend.Pets != null && Model.Friend.Pets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Kind</th>
                                    <th>Mood</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pet in Model.Friend.Pets)
                                {
                                    <tr>
                                        <td>@pet.Name</td>
                                        <td>@pet.Kind</td>
                                        <td>@pet.Mood</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        No pets
                    </div>
                }
            </div>
        </div>

        <!-- Quotes -->
        <div class="row mb-5">
            <div class="col-12">
                <h3>Quotes</h3>
                @if (Model.Friend.Quotes != null && Model.Friend.Quotes.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Quote</th>
                                    <th>Author</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var quote in Model.Friend.Quotes)
                                {
                                    <tr>
                                        <td>@quote.QuoteText</td>
                                        <td>@quote.Author</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        No quotes
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Loading friend details...
        </div>
    }
</div>
