@page "{id:guid}"
@model FriendDetailsModel
@using Models.Interfaces

@{
    ViewData["Title"] = Model.Friend != null ? $"{Model.Friend.FirstName} {Model.Friend.LastName}" : "Friend Details";
}

<div class="container px-4 py-4">
    <!-- Back Button -->
    <div class="row mb-4">
        <div class="col-12">
            <a href="/ListFriends" class="btn btn-secondary">← Back</a>
            @if (Model.Friend != null)
            {
                <a href="/EditFriend/@Model.Friend.FriendId" class="btn btn-warning">Edit Friend</a>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ErrorMessage
        </div>
    }
    else if (Model.Friend != null)
    {
        <!-- Friend Information -->
        <div class="row mb-5">
            <div class="col-12">
                <h1>@Model.Friend.FirstName @Model.Friend.LastName</h1>
                <div class="card">
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h6 class="text-muted">Email</h6>
                                <p>@Model.Friend.Email</p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted">Birthday</h6>
                                <p>@(Model.Friend.Birthday?.ToString("yyyy-MM-dd") ?? "Not set")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Information -->
        @if (Model.Friend.Address != null)
        {
            <div class="row mb-5">
                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3>Address</h3>
                        <a href="/EditAddress/@Model.Friend.FriendId" class="btn btn-sm btn-warning">Edit Address</a>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <h6 class="text-muted">Street Address</h6>
                                    <p>@Model.Friend.Address.StreetAddress</p>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-muted">Zip Code</h6>
                                    <p>@Model.Friend.Address.ZipCode</p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <h6 class="text-muted">City</h6>
                                    <p>@Model.Friend.Address.City</p>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="text-muted">Country</h6>
                                    <p>@Model.Friend.Address.Country</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Pets -->
        <div class="row mb-5">
            <div class="col-12">
                <h3>Pets</h3>
                @if (Model.Friend.Pets != null && Model.Friend.Pets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Kind</th>
                                    <th>Mood</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pet in Model.Friend.Pets)
                                {
                                    <tr>
                                        <td>@pet.Name</td>
                                        <td>@pet.Kind</td>
                                        <td>@pet.Mood</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-danger" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#deletePetModal"
                                                    onclick="setPetToDelete('@pet.PetId', '@pet.Name')">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        No pets
                    </div>
                }
            </div>
        </div>

        <!-- Quotes -->
        <div class="row mb-5">
            <div class="col-12">
                <h3>Quotes</h3>
                @if (Model.Friend.Quotes != null && Model.Friend.Quotes.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Quote</th>
                                    <th>Author</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var quote in Model.Friend.Quotes)
                                {
                                    <tr>
                                        <td>@quote.QuoteText</td>
                                        <td>@quote.Author</td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-danger" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#deleteQuoteModal"
                                                    onclick="setQuoteToDelete('@quote.QuoteId', '@quote.QuoteText')">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        No quotes
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Loading friend details...
        </div>
    }

    <!-- Delete Pet Modal -->
    @if (Model.Friend != null)
    {
        <div class="modal fade" id="deletePetModal" tabindex="-1" aria-labelledby="deletePetModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deletePetModalLabel">Delete Pet?</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete <strong id="petName"></strong>?
                        <p class="text-danger mt-3">This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form method="post" id="deletePetForm" style="display:inline;">
                            <input type="hidden" name="handler" value="DeletePet" />
                            <input type="hidden" name="friendId" value="@Model.Friend.FriendId" />
                            <input type="hidden" name="petId" id="petIdInput" />
                            <button type="submit" class="btn btn-danger">Delete Pet</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delete Quote Modal -->
        <div class="modal fade" id="deleteQuoteModal" tabindex="-1" aria-labelledby="deleteQuoteModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteQuoteModalLabel">Delete Quote?</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete this quote?
                        <p class="text-muted mt-2" id="quoteText"></p>
                        <p class="text-danger mt-3">This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form method="post" id="deleteQuoteForm" style="display:inline;">
                            <input type="hidden" name="handler" value="DeleteQuote" />
                            <input type="hidden" name="friendId" value="@Model.Friend.FriendId" />
                            <input type="hidden" name="quoteId" id="quoteIdInput" />
                            <button type="submit" class="btn btn-danger">Delete Quote</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- JavaScript for modals -->
        <script>
            function setPetToDelete(petId, petName) {
                document.getElementById('petIdInput').value = petId;
                document.getElementById('petName').textContent = petName;
            }

            function setQuoteToDelete(quoteId, quoteText) {
                document.getElementById('quoteIdInput').value = quoteId;
                document.getElementById('quoteText').textContent = quoteText;
            }
        </script>
    }
</div>
