@page
@model FriendsPetsModel
@using Models.Interfaces

@{
    ViewData["Title"] = "Friends & Pets by City";
}

<div class="container px-4 py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Friends & Pets by City</h1>
            <p class="text-muted">Select a country and city to view friends and their pets</p>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="row mb-4">
        <div class="col-12">
            <form method="post" class="bg-light p-3 rounded">
                <!-- Country + City Row -->
                <div class="row mb-3">
                    <div class="col-md-5">
                        <label for="countrySelect" class="form-label">Country</label>
                        <select class="form-select" name="country" id="countrySelect">
                            <option value="">-- Select Country --</option>
                            @foreach (var country in Model.Countries)
                            {
                                <option value="@country" selected="@(Model.SelectedCountry == country)">@country</option>
                            }
                        </select>
                    </div>
                    
                    <div class="col-md-5">
                        <label for="citySelect" class="form-label">City</label>
                        <select class="form-select" name="city" id="citySelect" disabled="@string.IsNullOrEmpty(Model.SelectedCountry)">
                            <option value="">-- Select City --</option>
                            @foreach (var city in Model.Cities)
                            {
                                <option value="@city" selected="@(Model.SelectedCity == city)">@city</option>
                            }
                        </select>
                    </div>
                    
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Filter</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results -->
    @if (!string.IsNullOrEmpty(Model.SelectedCountry) && !string.IsNullOrEmpty(Model.SelectedCity))
    {
        <!-- Friends Table -->
        <div class="row mb-5">
            <div class="col-12">
                <h3>Friends in @Model.SelectedCity, @Model.SelectedCountry</h3>
                @if (Model.Friends.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Birthday</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var friend in Model.Friends)
                                {
                                    <tr>
                                        <td>@friend.FirstName @friend.LastName</td>
                                        <td>@friend.Email</td>
                                        <td>@friend.Birthday?.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        No friends found in @Model.SelectedCity, @Model.SelectedCountry
                    </div>
                }
            </div>
        </div>

        <!-- Pets Table -->
        <div class="row mb-5">
            <div class="col-12">
                <h3>Pets in @Model.SelectedCity, @Model.SelectedCountry</h3>
                @if (Model.Pets.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Pet Name</th>
                                    <th>Kind</th>
                                    <th>Mood</th>
                                    <th>Owner</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pet in Model.Pets)
                                {
                                    var owner = Model.Friends.FirstOrDefault(f => f.Pets?.Any(p => p.PetId == pet.PetId) ?? false);
                                    <tr>
                                        <td>@pet.Name</td>
                                        <td>@pet.Kind</td>
                                        <td>@pet.Mood</td>
                                        <td>@owner?.FirstName @owner?.LastName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        No pets found in @Model.SelectedCity, @Model.SelectedCountry
                    </div>
                }
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.SelectedCountry) && string.IsNullOrEmpty(Model.SelectedCity))
    {
        <div class="alert alert-info" role="alert">
            Select a city and click Filter to view friends and pets
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            Select a country and city, then click Filter to view results
        </div>
    }
</div>
